{
  "name": "astrovitals",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "npx electron .",
    "electron:build": "electron-builder --linux --mac --win"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "electron": "28.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "productName": "AstraVitals",
    "copyright": "Copyright © 2026",
    "appId": "com.astrovitals.app",
    "files": [
      "out/**/*",
      "build/**/*",
      "src/**/*"
    ],
    "linux": [
      {
        "target": ["AppImage", "Deb"]
      }
    ],
    "mac": [
      {
        "target": ["dmg", "zip"]
      }
    ],
    "win": [
      {
        "target": ["msi", "exe"]
      }
    ]
  }
}